# Example environment variables for backend
# Copy this to `backend/.env` and fill with your real credentials before running the server.

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database (Prisma) - example for SQLite or Postgres
# For sqlite: DATABASE_URL="file:./dev.db"
# For postgres: DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="file:./dev.db"

# JWT secret used for signing auth tokens
JWT_SECRET=replace_with_a_strong_random_secret

# Optional API key for Gemini / external AI usage
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# Server port
PORT=4000

# Environment
NODE_ENV=development
